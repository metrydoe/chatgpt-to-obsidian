{
  "manifest_version": 3,
  "name": "ChatGPT → Obsidian",
  "version": "0.8.2",
  "description": "将聊天保存为可编辑笔记，保留公式、代码、本地图片及原位交互组件。",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "归档到 Obsidian"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.oaiusercontent.com/*",
    "https://*.oaistatic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
